diff --git a/connectivity/bt/mt66xx/btif/Kbuild b/connectivity/bt/mt66xx/btif/Kbuild
index 218506c..dffce13 100644
--- a/connectivity/bt/mt66xx/btif/Kbuild
+++ b/connectivity/bt/mt66xx/btif/Kbuild
@@ -98,7 +98,12 @@ endif
 ccflags-y += -D CHIP_IF_BTIF
 
 # Use device node or hci_dev as native interface
+# TETRIS_LINUX_HCI=1: register a normal HCI device for BlueZ instead of /dev/stpbt (Android HAL)
+ifeq ($(TETRIS_LINUX_HCI),1)
+ccflags-y += -D USE_DEVICE_NODE=0
+else
 ccflags-y += -D USE_DEVICE_NODE=1
+endif
 
 # Customized fw update feature
 ccflags-y += -D CUSTOMER_FW_UPDATE=0
diff --git a/connectivity/bt/mt66xx/btif/btmtk_btif_main.c b/connectivity/bt/mt66xx/btif/btmtk_btif_main.c
index 47fbeac..1162c84 100644
--- a/connectivity/bt/mt66xx/btif/btmtk_btif_main.c
+++ b/connectivity/bt/mt66xx/btif/btmtk_btif_main.c
@@ -586,7 +586,7 @@ void bt_notify_state(void)
  *     0 if success, otherwise error code
  *
  */
-void bt_report_hw_error()
+void bt_report_hw_error(void)
 {
 	const uint8_t HCI_EVT_HW_ERROR[] = {0x04, 0x10, 0x01, 0x00};
 	btmtk_recv(g_sbdev->hdev, HCI_EVT_HW_ERROR, sizeof(HCI_EVT_HW_ERROR));
