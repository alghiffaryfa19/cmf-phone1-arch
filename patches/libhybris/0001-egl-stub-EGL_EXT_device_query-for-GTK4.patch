+/* EGL_EXT_device_query stubs: no EGL device information on libhybris. GTK 4.24
+ * calls eglQueryDisplayAttribEXT unconditionally; without a provider libepoxy aborts.
+ * They must set an EGL error: mutter turns eglGetError() into a GError and crashes on
+ * a NULL one when the call failed with EGL_SUCCESS. */
+static EGLBoolean hybris_eglQueryDisplayAttribEXT(EGLDisplay dpy, EGLint attribute, EGLAttrib *value)
+{
+	__eglHybrisSetError(EGL_BAD_ATTRIBUTE);
+	return EGL_FALSE;
+}
+
+static EGLBoolean hybris_eglQueryDeviceAttribEXT(void *device, EGLint attribute, EGLAttrib *value)
+{
+	__eglHybrisSetError(EGL_BAD_ATTRIBUTE);
+	return EGL_FALSE;
+}
+
+static const char *hybris_eglQueryDeviceStringEXT(void *device, EGLint name)
+{
+	__eglHybrisSetError(EGL_BAD_PARAMETER);
+	return NULL;
+}
