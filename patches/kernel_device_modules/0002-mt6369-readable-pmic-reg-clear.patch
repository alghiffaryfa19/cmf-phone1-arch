+/* Without a get, reading the control fails with -EPERM, and that makes
+ * snd_mixer_load() (PipeWire's jack detection) fail for the whole card.
+ */
+static int mt6369_rcv_acc_get(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	ucontrol->value.integer.value[0] = 0;
+	return 0;
+}
