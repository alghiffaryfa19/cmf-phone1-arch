# Linux userspace (systemd + LXC/libhybris) on top of gki_defconfig + mgk_64_k61_defconfig.
# Merged last, so these win.

# --- systemd / udev
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CGROUP_BPF=y

# --- console / VT (GNOME/logind expect a VT)
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y

# --- LXC container for the Android vendor side (Halium)
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_MACVLAN=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y

# --- debugging over USB (NCM gadget + telnet in initramfs)
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# --- we rebuild every module ourselves: no KMI trimming, no signature enforcement
# CONFIG_TRIM_UNUSED_KSYMS is not set
# CONFIG_MODULE_SIG_PROTECT is not set
# CONFIG_MODULE_SIG_FORCE is not set
CONFIG_LOCALVERSION="-tetris-linux"
# CONFIG_LOCALVERSION_AUTO is not set

# --- host has no pahole; BTF is only debug info
# CONFIG_DEBUG_INFO_BTF is not set

# --- Bluetooth for BlueZ: /dev/vhci bridge to the MTK /dev/stpbt (tetris-bt-bridge), BNEP for PAN
CONFIG_BT_HCIVHCI=m
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y

# --- Server profile: Docker / Podman (moby check-config.sh), iptables-nft and legacy
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PERF=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_NAT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NF_SOCKET_IPV4=y
CONFIG_NF_SOCKET_IPV6=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_VXLAN=y
CONFIG_IPVLAN=y
CONFIG_DM_THIN_PROVISIONING=y
