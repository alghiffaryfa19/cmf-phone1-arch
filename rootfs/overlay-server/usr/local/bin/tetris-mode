#!/bin/sh
# Switch the phone between its profiles. Takes effect on the next boot.
#   server   headless: no Phosh, panel off, Docker, Ollama in Docker, mDNS
#   desktop  server + a GNOME desktop over RDP (headless GNOME session of alarm,
#            gnome-remote-desktop; needs the SO_PEERPIDFD kernel patch)
#   phone    Phosh on the panel
#
#   tetris-mode server [--with-modem]   # --with-modem keeps mobile data (needs the Halium container)
#   tetris-mode desktop [--with-modem]
#   tetris-mode phone
#   tetris-mode                         # show the current profile
set -eu

# Phone-only services. The Halium container (tetris-android) is not enabled on its own:
# Phosh and the modem pull it in, so without them it stays off and its RAM stays free.
PHONE="tetris-phosh tetris-sensors tetris-vibra tetris-torch tetris-gnss tetris-fp bluetooth tetris-bt-bridge"
MODEM="ModemManager tetris-modem"
SERVER="tetris-display-off docker avahi-daemon systemd-oomd tetris-ai"
# gnome-headless-session@alarm: GNOME session without a display, started with GDM.
# tetris-android: its gralloc HAL lets GNOME Shell and the apps render on the Mali GPU.
# The system gnome-remote-desktop (RDP in front of GDM) stays off.
DESKTOP="gdm gnome-headless-session@alarm tetris-android"
# 72-tetris-headless-seat.rules: takes the panel out of seat0 (no GDM login screen on it)
SEATFLAG=/etc/tetris-headless-seat

# enable/disable only units that are installed (gnss, fp ... come from setup-phone.sh)
units() {
    for u in "$@"; do
        t=$(echo "$u" | sed 's/@.*/@/')
        [ -n "$(systemctl list-unit-files --no-legend "$t.service" 2>/dev/null)" ] && printf '%s ' "$u"
    done
    return 0
}
en() { u=$(units "$@"); [ -z "$u" ] || systemctl enable $u; }
dis() { u=$(units "$@"); [ -z "$u" ] || systemctl disable $u; }

headless() { # headless <--with-modem or empty>
    if [ "${1:-}" = --with-modem ]; then en $MODEM; else dis $MODEM; fi
    dis $PHONE
    en $SERVER
}

case ${1:-} in
server)
    headless "${2:-}"
    dis $DESKTOP
    rm -f "$SEATFLAG"
    systemctl set-default multi-user.target
    echo "server profile from the next boot on"
    ;;
desktop)
    [ -n "$(units gdm)" ] && [ -x /usr/bin/grdctl ] ||
        { echo "tetris-mode: gdm and gnome-remote-desktop are not installed" >&2; exit 1; }
    headless "${2:-}"
    dis gnome-remote-desktop
    en $DESKTOP
    # RDP certificate + password on alarm's first login (user unit, ConditionUser=alarm)
    systemctl --global enable tetris-rdp-setup.service
    touch "$SEATFLAG"
    systemctl set-default graphical.target
    echo "desktop profile (RDP) from the next boot on"
    ;;
phone)
    dis $SERVER $DESKTOP
    rm -f "$SEATFLAG"
    en $PHONE $MODEM
    systemctl set-default graphical.target
    echo "phone profile (Phosh) from the next boot on"
    ;;
"")
    if [ -e "$SEATFLAG" ]; then echo desktop
    elif [ "$(systemctl get-default)" = multi-user.target ]; then echo server
    else echo phone; fi
    ;;
*)
    echo "usage: tetris-mode [server [--with-modem] | desktop [--with-modem] | phone]" >&2
    exit 1
    ;;
esac
