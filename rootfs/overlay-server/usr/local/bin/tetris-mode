#!/bin/sh
# Switch the phone between the server profile (headless: no Phosh, panel off, Docker,
# Ollama in Docker, mDNS) and the normal phone profile. Takes effect on the next boot.
#
#   tetris-mode server [--with-modem]   # --with-modem keeps mobile data (needs the Halium container)
#   tetris-mode phone
#   tetris-mode                         # show the current profile
set -eu

# Phone-only services. The Halium container (tetris-android) is not enabled on its own:
# Phosh and the modem pull it in, so without them it stays off and its RAM stays free.
PHONE="tetris-phosh tetris-sensors tetris-vibra tetris-torch tetris-gnss tetris-fp bluetooth tetris-bt-bridge"
MODEM="ModemManager tetris-modem"
SERVER="tetris-display-off docker avahi-daemon systemd-oomd tetris-ai"

# Only units that are installed (gnss, fp ... come from setup-phone.sh)
have() {
    for u in "$@"; do
        [ -n "$(systemctl list-unit-files --no-legend "$u.service" 2>/dev/null)" ] && printf '%s ' "$u"
    done
    return 0
}

case ${1:-} in
server)
    if [ "${2:-}" = --with-modem ]; then
        # shellcheck disable=SC2046
        systemctl enable $(have $MODEM)
    else
        # shellcheck disable=SC2046
        systemctl disable $(have $MODEM)
    fi
    # shellcheck disable=SC2046
    systemctl disable $(have $PHONE)
    # shellcheck disable=SC2046
    systemctl enable $(have $SERVER)
    systemctl set-default multi-user.target
    echo "server profile from the next boot on"
    ;;
phone)
    # shellcheck disable=SC2046
    systemctl disable $(have $SERVER)
    # shellcheck disable=SC2046
    systemctl enable $(have $PHONE $MODEM)
    systemctl set-default graphical.target
    echo "phone profile (Phosh) from the next boot on"
    ;;
"")
    if [ "$(systemctl get-default)" = multi-user.target ]; then echo server; else echo phone; fi
    ;;
*)
    echo "usage: tetris-mode [server [--with-modem] | phone]" >&2
    exit 1
    ;;
esac
