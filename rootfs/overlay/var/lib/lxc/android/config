# Halium 16 container (LuneOS GSI) running only the Android services libhybris needs.
# Based on LuneOS/Droidian lxc-android, adapted for the CMF Phone 1 Linux port:
# own network namespace (Android must not touch the host's WLAN/routes), vendor
# from super with an init allowlist (tetris-android-prepare).
lxc.rootfs.path = /var/lib/lxc/android/rootfs
lxc.uts.name = android
lxc.arch = aarch64

lxc.tty.dir = lxc
lxc.tty.max = 4
lxc.pty.max = 1024
lxc.cap.drop = mac_admin mac_override
lxc.apparmor.profile = unconfined
lxc.net.0.type = empty
lxc.init.cmd = /init
lxc.autodev = 0

lxc.mount.entry = tmpfs dev tmpfs nosuid 0 0
lxc.mount.entry = /dev/null dev/null none bind,create=file 0 0
# Android init logs to /dev/kmsg; without it its errors are invisible
lxc.mount.entry = /dev/kmsg dev/kmsg none bind,create=file 0 0
lxc.mount.entry = /dev/__properties__ dev/__properties__ none bind,create=dir 0 0
lxc.mount.entry = /dev/binderfs dev/binderfs none bind,create=dir 0 0
lxc.mount.entry = /dev/socket dev/socket none bind,create=dir 0 0
lxc.mount.entry = proc proc proc nodev,noexec,nosuid 0 0
lxc.mount.entry = sysfs sys sysfs nodev,noexec,nosuid 0 0
# Android's system_suspend autosuspends via /sys/power/state (and our port never
# resumes from s2idle) - the container must not be able to suspend the host.
lxc.mount.entry = /sys/power sys/power none bind,ro 0 0
lxc.mount.entry = /android/data data none bind 0 0
lxc.mount.entry = /apex apex none rbind 0 0
lxc.mount.entry = /var/lib/tetris-android/vendor vendor none bind,ro 0 0
lxc.mount.entry = /var/lib/tetris-android/vendor-init vendor/etc/init none bind,ro 0 0
lxc.mount.entry = /odm odm none bind,ro 0 0
lxc.mount.entry = /vendor_dlkm vendor_dlkm none bind,ro 0 0
# GPU + display nodes the graphics HALs open
lxc.mount.entry = /dev/mali0 dev/mali0 none bind,create=file 0 0
lxc.mount.entry = /dev/dri dev/dri none bind,create=dir 0 0
lxc.mount.entry = /dev/dma_heap dev/dma_heap none bind,create=dir,optional 0 0
# Modem and camera nodes (/dev/ccci*, modem partitions, V4L2), generated by tetris-android-prepare
lxc.include = /run/tetris-android-modem.conf
