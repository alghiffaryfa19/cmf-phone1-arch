[Unit]
Description=End the boot splash (Tux) before the composer or phoc take the display
DefaultDependencies=no
After=sysinit.target
Before=basic.target tetris-android.service tetris-phosh.service

[Service]
Type=oneshot
# The splash process comes from the initramfs (tetris-splash in initramfs/tools)
ExecStart=/bin/sh -c "pkill -x tetris-splash && echo splash ended || echo no splash running"

[Install]
WantedBy=basic.target
