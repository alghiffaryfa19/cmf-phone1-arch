[Unit]
Description=Fingerprint: TEE services and Goodix fingerprint HAL (Halium container)
Requires=tetris-android.service
After=tetris-android.service

[Service]
ExecStart=/usr/local/bin/tetris-fp-hal
# never leave the touch controller in fingerprint mode or the panel in high brightness
ExecStopPost=-/bin/sh -c "echo 0 > /proc/touchpanel/fod_mode; echo 0 > /sys/panel_feature/ui_status; echo 0 > /sys/panel_feature/hbm_mode"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
