# Environment for programs that use the Mali GPU through libhybris (/opt/libhybris).
# The Halium container (tetris-android.service) must be running for the gralloc HAL.
LD_LIBRARY_PATH=/opt/libhybris/lib
HYBRIS_LD_LIBRARY_PATH=/opt/tetris-hybris-compat/lib64:/vendor/lib64:/vendor/lib64/egl:/system/lib64:/odm/lib64
