# Camera nodes belong to the Android camera HAL in the Halium container
# (camerahalserver: uid cameraserver, groups camera=1006 and system=1000), as in the
# vendor ueventd.rc. Container ids = host ids (no idmap). Android ids have no host
# accounts, which OWNER/GROUP need, hence chown.
SUBSYSTEM=="video4linux|media", MODE="0660", RUN+="/usr/bin/chown 1006:1000 $devnode"
KERNEL=="mtk_ccd|mtk_hcp|mtk_mdp|mdp_sync|camera-pda|ccu*|vcu|mtk_aov", ENV{DEVNAME}=="?*", MODE="0660", RUN+="/usr/bin/chown 1006:1000 $devnode"
KERNEL=="camera_eeprom*", MODE="0660", RUN+="/usr/bin/chown 1000:1006 $devnode"
# DMA-BUF heaps: allocating needs only read access; Android's ueventd makes them 0444
# (owner system) so the camera HAL (and gralloc) can allocate.
SUBSYSTEM=="dma_heap", MODE="0444", RUN+="/usr/bin/chown 1000:1000 $devnode"
# ashmem: libhybris clients receive camera metadata in ashmem blobs; libcutils opens
# /dev/ashmem to validate them (Android's ueventd makes it 0666)
KERNEL=="ashmem", MODE="0666"
