#!/bin/sh
# Start the GPS services in the Halium container (tetris-gnss.rc) and wait for the
# GNSS HAL. conninfra_loader first: mnld needs the chip id properties it sets.
A="lxc-attach -n android --"
for i in $(seq 60); do
    [ "$($A /system/bin/getprop servicemanager.ready 2>/dev/null)" = true ] && break
    sleep 1
done
$A /system/bin/setprop ctl.start conninfra_loader
for i in $(seq 20); do
    [ "$($A /system/bin/getprop vendor.connsys.driver.ready 2>/dev/null)" = yes ] && break
    sleep 0.5
done
# agpsd talks to the modem on /dev/ttyC2, radio:radio as in the vendor ueventd.rc
chown 1001:1001 /dev/ttyC2
$A /system/bin/setprop ctl.start agpsd
$A /system/bin/setprop ctl.start mnld
$A /system/bin/setprop ctl.start vendor.gnss-tetris
for i in $(seq 30); do
    $A /system/bin/service check android.hardware.gnss.IGnss/default 2>/dev/null |
        grep -q ': found' && { echo "GNSS HAL up"; exit 0; }
    sleep 1
done
echo "GNSS HAL did not come up" >&2
exit 1
