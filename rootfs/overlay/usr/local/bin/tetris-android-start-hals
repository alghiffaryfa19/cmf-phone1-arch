#!/bin/sh
# Start the vendor HALs libhybris needs inside the Halium container. Its init stops
# after post-fs-data (no "boot", no "class_start hal"), and property triggers in vendor
# rc files don't fire there, so ask init via ctl.start once servicemanager is up.
# The composer HAL (vendor.hwcomposer-3-2) is NOT started here: while phoc holds DRM
# master it busy-loops on drmSetMaster. It's started by whoever takes the display over.
# mtkpower: the camera HAL needs it (tetris-camera), and it takes ~90 s to register
HALS="vendor.gralloc-v2 vender.mediatek.hardware.pq_aidl-default vendor.mtkpower-service.mediatek"
# GPU Phosh mode owns the display through the composer instead of DRM
# (not after a failed GPU start: tetris-phosh-select falls back to software then)
GPU=
[ -e /etc/tetris-android/gpu-shell ] && [ ! -e /var/lib/tetris-android/gpu-attempt ] && GPU=1
[ -n "$GPU" ] && HALS="$HALS vendor.hwcomposer-3-2"
A="lxc-attach -n android --"
for i in $(seq 60); do
    [ "$($A /system/bin/getprop servicemanager.ready 2>/dev/null)" = true ] && break
    sleep 1
done
for h in $HALS; do
    $A /system/bin/setprop ctl.start "$h"
done
wait_for() {
    for i in $(seq 30); do
        $A /system/bin/service check "$1" 2>/dev/null | grep -q ': found' && { echo "$1 up"; return 0; }
        sleep 1
    done
    echo "$1 did not come up" >&2
    return 1
}
wait_for android.hardware.graphics.allocator.IAllocator/default || exit 1
if [ -n "$GPU" ]; then
    wait_for android.hardware.graphics.composer3.IComposer/default || exit 1
fi
exit 0
