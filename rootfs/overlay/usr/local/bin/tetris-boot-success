#!/usr/bin/python3
# Mark the current A/B slot as successfully booted (what Android's boot_control HAL
# markBootSuccessful() does). Without it MTK LK decrements the slot's retry count on
# every boot; at 0 the slot becomes unbootable and LK falls back to the other slot
# (stock Android there can't mount our ext4 userdata -> recovery boot loop).
#
# MTK bootctrl block: misc @ 0x800, 32 bytes, magic "BCAB", CRC32 (LE) over bytes 0..27.
# slot_info[i] at byte 12+2*i: bits 0-3 priority, 4-6 retries left, 7 successful
# (layout verified on device: retries 6 -> 5 across one boot).
import re, struct, sys, zlib

MISC, OFF = "/dev/disk/by-partlabel/misc", 0x800

m = re.search(r'androidboot\.slot_suffix\s*=\s*"_([ab])"', open("/proc/bootconfig").read())
if not m:
    sys.exit("no androidboot.slot_suffix in /proc/bootconfig")
slot = "ab".index(m.group(1))

with open(MISC, "r+b") as f:
    f.seek(OFF)
    blk = bytearray(f.read(32))
    if blk[4:8] != b"BCAB":
        sys.exit(f"unexpected bootctrl magic {blk[4:8]!r}")
    if struct.unpack("<I", blk[28:32])[0] != zlib.crc32(blk[:28]):
        sys.exit("bootctrl CRC mismatch, not touching it")
    i = 12 + 2 * slot
    if blk[i] & 0x80:
        print(f"slot {'ab'[slot]} already marked successful")
        sys.exit(0)
    blk[i] |= 0x80
    blk[28:32] = struct.pack("<I", zlib.crc32(blk[:28]))
    f.seek(OFF)
    f.write(blk)
print(f"slot {'ab'[slot]} marked successful")
