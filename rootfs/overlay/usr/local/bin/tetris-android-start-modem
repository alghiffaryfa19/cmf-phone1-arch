#!/bin/sh
# Boot the modem CPU: the bootloader loaded its firmware, ccci_mdinit (in the Halium
# container) starts it and serves the NVRAM file system it needs. These partitions
# hold IMEI + RF calibration: they're only mounted inside the container, by name.
set -u
A="lxc-attach -n android --"
log() { echo "tetris-android-start-modem: $*"; }

# Already up (bridge restart)
[ "$(cat /sys/kernel/ccci/boot)" = "md1:4" ] && { log "modem already running"; exit 0; }

# Android's init mounts a tmpfs over /mnt, so these can't come from the lxc config
mnt() { # mnt <partition> <dir>
    $A /system/bin/mkdir -p "/mnt/vendor/$2"
    $A /system/bin/mount -t ext4 -o noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc \
        "/dev/block/by-name/$1" "/mnt/vendor/$2" || { log "cannot mount $1"; exit 1; }
}
mnt nvdata nvdata
mnt nvcfg nvcfg
mnt protect1 protect_f
mnt protect2 protect_s
mnt persist persist
$A /system/bin/chown root:system /mnt/vendor/nvdata
$A /system/bin/chmod 0771 /mnt/vendor/nvdata
$A /system/bin/chown system:system /mnt/vendor/nvcfg /mnt/vendor/protect_f /mnt/vendor/protect_s
$A /system/bin/mkdir -p /mnt/vendor/nvdata/md /mnt/vendor/nvdata/md3 /data/vendor/md3 \
    /data/vendor/mdlpm /data/vendor_de/md /data/vendor/radio
$A /system/bin/chown root:system /mnt/vendor/nvdata/md /mnt/vendor/nvdata/md3 /data/vendor/md3
$A /system/bin/chown system:radio /data/vendor/mdlpm /data/vendor_de/md
$A /system/bin/chown radio:radio /data/vendor/radio

$A /system/bin/setprop ctl.start nvram_daemon
for i in $(seq 30); do
    [ "$($A /system/bin/getprop vendor.service.nvram_init)" = Ready ] && break
    sleep 1
done
log "nvram_init=$($A /system/bin/getprop vendor.service.nvram_init)"

$A /system/bin/setprop ctl.start ccci_mdinit
$A /system/bin/setprop ctl.start vendor.ccci_rpcd
for i in $(seq 60); do
    [ "$(cat /sys/kernel/ccci/boot)" = "md1:4" ] && break
    sleep 1
done
log "$(cat /sys/kernel/ccci/boot)"
[ "$(cat /sys/kernel/ccci/boot)" = "md1:4" ] || exit 1

# The modem comes up in flight mode with the SIM off, which ModemManager would report as
# "SIM missing". Radio on here, before the bridge and ModemManager. The PIN stays with the user.
exec 3<>/dev/ttyC0
at() { # at <command> <timeout>
    printf '%s\r' "$1" >&3
    timeout "$2" grep -m1 -E 'OK|ERROR' <&3
}
for i in $(seq 20); do
    at AT 2 >/dev/null && break
done
at AT+CFUN=1 30 >/dev/null || log "AT+CFUN=1 failed"
exec 3<&-
sleep 3
log "radio on"
